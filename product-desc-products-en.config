<?xml version="1.0" encoding="windows-1252"?>
<!--
  Sample products for the Product Description Generator example
  (product-desc-agent). Each <product> becomes a ProductInfo run through
  ReflectionAgent (produce -> critique -> refine) to generate a polished
  web shop description. The <internal> element is metadata for the reader
  (what the sample is meant to demonstrate) - the loader ignores it and
  only reads <productName>, <keyFeatures>, <targetAudience>, <pricePoint>
  and <wordLimit>.

  Three price tiers (mid-range / budget / premium) show the same agent
  adapting its tone from matter-of-fact to aspirational.
-->
<products>

  <!-- 1 -->
  <product>
    <internal>Mid-range office chair for home-office/hybrid workers. Expect a balanced, professional tone.</internal>
    <productName>ErgoPro Office Chair</productName>
    <keyFeatures>Adjustable lumbar support, 4D armrests, breathable mesh back, 150 kg weight capacity, 10-year warranty</keyFeatures>
    <targetAudience>Home-office workers and office professionals</targetAudience>
    <pricePoint>mid-range</pricePoint>
    <wordLimit>80-120 words</wordLimit>
  </product>

  <!-- 2 -->
  <product>
    <internal>Budget power bank for travellers. Expect a matter-of-fact, value-focused tone.</internal>
    <productName>SlimPower 20000 Power Bank</productName>
    <keyFeatures>20,000 mAh capacity, 3 USB ports, 65 W USB-C Power Delivery, LED charge indicator, 380 g</keyFeatures>
    <targetAudience>Frequent travelers and tech-savvy users</targetAudience>
    <pricePoint>budget</pricePoint>
    <wordLimit>60-90 words</wordLimit>
  </product>

  <!-- 3 -->
  <product>
    <internal>Premium electric standing desk. Expect an aspirational, design-led tone.</internal>
    <productName>CedarWood Desk 180 cm</productName>
    <keyFeatures>Solid cedar wood, electric height adjustment 68-118 cm, integrated cable management, anti-collision sensor, 10-year warranty</keyFeatures>
    <targetAudience>Design-conscious home-office owners</targetAudience>
    <pricePoint>premium</pricePoint>
    <wordLimit>100-140 words</wordLimit>
  </product>

</products>
