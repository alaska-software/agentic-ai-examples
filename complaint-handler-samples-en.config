<?xml version="1.0" encoding="windows-1252"?>
<!--
   complaint-handler-samples-en.config

   Sample customer complaints for the ComplaintHandlerAgent example.
   Each <complaint> represents one inbound customer message. The agent
   runs three parallel assessments (defect likelihood, customer profile,
   policy entitlement) and produces a resolution decision plus a draft reply.
   The <internal> element is metadata for the reader (what each scenario is
   meant to exercise) - the loader ignores it and only reads <customerId>,
   <orderNumber>, <channel>, <subject>, <body> and <productName>.

   Scenarios covered:
     1. VIP customer - clear manufacturing defect  -> urgent replace/refund
     2. New customer - wrong item delivered         -> refund (policy: no time limit)
     3. Regular customer - duplicate charge         -> refund (policy clause 5)
     4. New customer - change of mind, 45 days old  -> decline (outside 30-day window)
-->
<complaints>

  <!-- 1 -->
  <complaint>
    <internal>VIP customer, clear manufacturing defect. Expect: urgent replace/refund.</internal>
    <customerId>CUST-001</customerId>
    <orderNumber>ORD-8821</orderNumber>
    <channel>email</channel>
    <subject>Defective coffee machine delivered</subject>
    <body>We received the Gastroback 42609 professional coffee machine yesterday.
From the very first use the pump makes a loud grinding noise and the milk
frother produces no steam at all. We rely on this machine daily for a team
of twelve people. This is clearly a manufacturing defect and we need an
immediate replacement - we cannot operate without it.</body>
    <productName>Gastroback 42609 Coffee Machine</productName>
  </complaint>

  <!-- 2 -->
  <complaint>
    <internal>New customer, wrong item delivered. Expect: refund (policy: no time limit).</internal>
    <customerId>CUST-002</customerId>
    <orderNumber>ORD-9134</orderNumber>
    <channel>webshop</channel>
    <subject>Wrong item delivered - requesting refund</subject>
    <body>I ordered a 5-tier steel shelving unit (item SH-500) but received
a 3-tier model instead. The packing slip also shows the wrong item number.
I no longer need the item and would like a full refund. The unit is still
in its original sealed packaging and has not been assembled.</body>
    <productName>Steel Shelving Unit SH-500</productName>
  </complaint>

  <!-- 3 -->
  <complaint>
    <internal>Regular customer, duplicate charge. Expect: refund (policy clause 5).</internal>
    <customerId>CUST-003</customerId>
    <orderNumber>ORD-9041</orderNumber>
    <channel>email</channel>
    <subject>Double charge on my account</subject>
    <body>My bank statement shows that EUR 234.50 was charged twice on
14 March for order ORD-9041. I have received only one shipment.
Please refund the duplicate payment as quickly as possible.
I can provide a copy of my bank statement if required.</body>
    <productName>Office Supplies Bundle</productName>
  </complaint>

  <!-- 4 -->
  <complaint>
    <internal>New customer, change of mind, 45 days old. Expect: decline (outside 30-day window).</internal>
    <customerId>CUST-002</customerId>
    <orderNumber>ORD-7788</orderNumber>
    <channel>phone</channel>
    <subject>Return request - changed my mind</subject>
    <body>I bought a laser printer 45 days ago but have since decided
I do not need it after all. The box has never been opened.
I realise this may be past your normal return window but I was hoping
you could make an exception. I would like a full refund if possible.</body>
    <productName>HP LaserJet M110w Printer</productName>
  </complaint>

</complaints>
