<?xml version="1.0" encoding="windows-1252"?>
<!--
  Finanzfragen fuer das Calculator-Tool-Beispiel (Finanzrechner + Live-
  Waehrungsumrechnung, deutsche Fassung von
  calculator-tool-questions-en.config). Jede <question> wird zu einem
  Prompt an PromptRunner:generateText() mit CalculatorTool + CurrencyTool.
  Das Element <internal> ist Metadaten fuer den Leser (welche Tool-Sequenz
  das jeweilige Szenario pruefen soll) - der Loader ignoriert es und liest
  nur <text>.
-->
<questions>

  <!-- 1 -->
  <question>
    <internal>Rechnung mit Mehrwertsteuer, Ergebnis in zwei Waehrungen. Erwartete Tool-Sequenz: Percentage -> Calculate(add) -> ConvertAmount</internal>
    <text>Eine Lieferantenrechnung zeigt EUR 8.400 netto. Wir müssen 19% deutsche Mehrwertsteuer hinzufügen.
Wie hoch ist der Mehrwertsteuerbetrag, der Bruttobetrag in EUR und der Bruttobetrag in USD?</text>
  </question>

  <!-- 2 -->
  <question>
    <internal>Budgetverfolgung, Rest in Fremdwaehrung. Erwartete Tool-Sequenz: Percentage -> Calculate(subtract) -> ConvertAmount</internal>
    <text>Unser jährliches Reisebudget beträgt USD 95.000. Bisher haben wir 38% davon ausgegeben.
Wie hoch ist der ausgegebene Betrag, das verbleibende Budget in USD und dieser Rest in EUR?</text>
  </question>

  <!-- 3 -->
  <question>
    <internal>Lieferantenvergleich ueber zwei Waehrungen. Erwartete Tool-Sequenz: ConvertAmount(GBP->USD) -> ConvertAmount(EUR->USD) -> Calculate(subtract)</internal>
    <text>Zwei Lieferanten bieten denselben Dienst an:
  Lieferant A: GBP 4.200
  Lieferant B: EUR 4.900
Welches Angebot ist in USD günstiger und um wie viel?</text>
  </question>

</questions>
