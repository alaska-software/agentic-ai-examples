<?xml version="1.0" encoding="windows-1252"?>
<!--
  Sample financial questions for the Financial Calculator + Live Currency
  Conversion example (calculator-tool). Each <question> becomes one prompt
  sent to PromptRunner:generateText() using CalculatorTool + CurrencyTool.
  The <internal> element is metadata for the reader (which tool-call
  sequence the scenario is meant to exercise) - the loader ignores it and
  only reads <text>.
-->
<questions>

  <!-- 1 -->
  <question>
    <internal>Invoice with VAT, result in two currencies. Expected tool sequence: Percentage -> Calculate(add) -> ConvertAmount</internal>
    <text>A supplier invoice shows EUR 8,400 net. We must add 19% German VAT.
What is the VAT amount, the gross total in EUR, and the gross total in USD?</text>
  </question>

  <!-- 2 -->
  <question>
    <internal>Budget tracking, remainder in foreign currency. Expected tool sequence: Percentage -> Calculate(subtract) -> ConvertAmount</internal>
    <text>Our annual travel budget is USD 95,000. We have spent 38% so far.
What is the amount spent, the remaining budget in USD, and that remainder in EUR?</text>
  </question>

  <!-- 3 -->
  <question>
    <internal>Supplier comparison across two currencies. Expected tool sequence: ConvertAmount(GBP->USD) -> ConvertAmount(EUR->USD) -> Calculate(subtract)</internal>
    <text>Two suppliers quote the same service:
  Supplier A: GBP 4,200
  Supplier B: EUR 4,900
Which offer is cheaper in USD and by how much?</text>
  </question>

</questions>
