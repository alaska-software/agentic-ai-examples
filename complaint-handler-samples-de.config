<?xml version="1.0" encoding="windows-1252"?>
<!--
   complaint-handler-samples-de.config

   Beispiel-Kundenbeschwerden fuer das ComplaintHandlerAgent-Beispiel
   (deutsche Fassung von complaint-handler-samples-en.config). Jede
   <complaint> stellt eine eingehende Kundennachricht dar. Der Agent fuehrt
   drei parallele Bewertungen durch (Mangelwahrscheinlichkeit, Kundenprofil,
   Anspruchspruefung) und erzeugt eine Loesungsentscheidung sowie einen
   Antwortentwurf. Das Element <internal> ist Metadaten fuer den Leser (was
   das jeweilige Szenario pruefen soll) - der Loader ignoriert es und liest
   nur <customerId>, <orderNumber>, <channel>, <subject>, <body> und
   <productName>.

   Abgedeckte Szenarien:
     1. VIP-Kunde - eindeutiger Herstellungsfehler    -> dringende Ersatzlieferung/Rueckerstattung
     2. Neukunde - falscher Artikel geliefert          -> Rueckerstattung (Richtlinie: keine Frist)
     3. Stammkunde - doppelte Abbuchung                -> Rueckerstattung (Richtlinienklausel 5)
     4. Neukunde - Meinungsaenderung, 45 Tage alt       -> Ablehnung (ausserhalb des 30-Tage-Fensters)
-->
<complaints>

  <!-- 1 -->
  <complaint>
    <internal>VIP-Kunde, eindeutiger Herstellungsfehler. Erwartet: dringende Ersatzlieferung/Rueckerstattung.</internal>
    <customerId>CUST-001</customerId>
    <orderNumber>ORD-8821</orderNumber>
    <channel>email</channel>
    <subject>Defekte Kaffeemaschine geliefert</subject>
    <body>Wir haben gestern die Gastroback 42609 Profi-Kaffeemaschine erhalten.
Schon beim ersten Gebrauch macht die Pumpe ein lautes Mahlgeräusch und der
Milchaufschäumer erzeugt überhaupt keinen Dampf. Wir sind auf dieses Gerät
täglich angewiesen, für ein Team von zwölf Personen. Das ist eindeutig ein
Herstellungsfehler, und wir benötigen umgehend Ersatz - wir können ohne das
Gerät nicht arbeiten.</body>
    <productName>Gastroback 42609 Kaffeemaschine</productName>
  </complaint>

  <!-- 2 -->
  <complaint>
    <internal>Neukunde, falscher Artikel geliefert. Erwartet: Rueckerstattung (Richtlinie: keine Frist).</internal>
    <customerId>CUST-002</customerId>
    <orderNumber>ORD-9134</orderNumber>
    <channel>webshop</channel>
    <subject>Falscher Artikel geliefert - Rückerstattung gewünscht</subject>
    <body>Ich habe ein 5-stöckiges Stahlregal (Artikel SH-500) bestellt, aber
ein 3-stöckiges Modell erhalten. Auch der Lieferschein zeigt die falsche
Artikelnummer. Ich benötige den Artikel nicht mehr und möchte eine
vollständige Rückerstattung. Das Regal ist noch original verpackt und
wurde nicht montiert.</body>
    <productName>Stahlregal SH-500</productName>
  </complaint>

  <!-- 3 -->
  <complaint>
    <internal>Stammkunde, doppelte Abbuchung. Erwartet: Rueckerstattung (Richtlinienklausel 5).</internal>
    <customerId>CUST-003</customerId>
    <orderNumber>ORD-9041</orderNumber>
    <channel>email</channel>
    <subject>Doppelte Abbuchung auf meinem Konto</subject>
    <body>Mein Kontoauszug zeigt, dass am 14. März EUR 234,50 zweimal
abgebucht wurden für Bestellung ORD-9041. Ich habe nur eine Lieferung
erhalten. Bitte erstatten Sie die doppelte Zahlung so schnell wie möglich.
Bei Bedarf kann ich eine Kopie meines Kontoauszugs zur Verfügung stellen.</body>
    <productName>Büromaterial-Set</productName>
  </complaint>

  <!-- 4 -->
  <complaint>
    <internal>Neukunde, Meinungsaenderung, 45 Tage alt. Erwartet: Ablehnung (ausserhalb des 30-Tage-Fensters).</internal>
    <customerId>CUST-002</customerId>
    <orderNumber>ORD-7788</orderNumber>
    <channel>phone</channel>
    <subject>Rückgabewunsch - habe es mir anders überlegt</subject>
    <body>Ich habe vor 45 Tagen einen Laserdrucker gekauft, aber inzwischen
entschieden, dass ich ihn doch nicht benötige. Die Verpackung wurde nie
geöffnet. Mir ist bewusst, dass dies außerhalb Ihres normalen
Rückgabefensters liegen könnte, aber ich hoffe, Sie können eine
Ausnahme machen. Ich hätte gerne eine vollständige Rückerstattung,
falls möglich.</body>
    <productName>HP LaserJet M110w Drucker</productName>
  </complaint>

</complaints>
