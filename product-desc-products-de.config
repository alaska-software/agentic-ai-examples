<?xml version="1.0" encoding="windows-1252"?>
<!--
  Beispielprodukte fuer das Product-Description-Generator-Beispiel
  (product-desc-agent, deutsche Fassung von
  product-desc-products-en.config). Jedes <product> wird zu einer
  ProductInfo, die durch den ReflectionAgent (produce -> critique ->
  refine) laeuft, um eine ausgefeilte Webshop-Beschreibung zu erzeugen.
  Das Element <internal> ist Metadaten fuer den Leser (was das jeweilige
  Beispiel demonstrieren soll) - der Loader ignoriert es und liest nur
  <productName>, <keyFeatures>, <targetAudience>, <pricePoint> und
  <wordLimit>.

  Drei Preisklassen (mid-range / budget / premium) zeigen, wie derselbe
  Agent seinen Ton von sachlich bis aspirational anpasst.
-->
<products>

  <!-- 1 -->
  <product>
    <internal>Buerostuhl der mittleren Preisklasse fuer Home-Office/Hybrid-Arbeitende. Erwartet einen ausgewogenen, professionellen Ton.</internal>
    <productName>ErgoPro Bürostuhl</productName>
    <keyFeatures>Lendenwirbelstütze verstellbar, 4D-Armlehnen, atmungsaktiver Netzrücken, 150 kg Traglast, 10-Jahres-Garantie</keyFeatures>
    <targetAudience>Home-Office-Nutzer und Büroprofis</targetAudience>
    <pricePoint>mid-range</pricePoint>
    <wordLimit>80-120 words</wordLimit>
  </product>

  <!-- 2 -->
  <product>
    <internal>Powerbank der Einstiegsklasse fuer Vielreisende. Erwartet einen sachlichen, nutzenorientierten Ton.</internal>
    <productName>SlimPower 20000 Powerbank</productName>
    <keyFeatures>20.000 mAh Kapazität, 3 USB-Ports, 65 W USB-C Power Delivery, LED-Ladestandsanzeige, 380 g</keyFeatures>
    <targetAudience>Vielreisende und technikaffine Nutzer</targetAudience>
    <pricePoint>budget</pricePoint>
    <wordLimit>60-90 words</wordLimit>
  </product>

  <!-- 3 -->
  <product>
    <internal>Elektrisch hoehenverstellbarer Premium-Schreibtisch. Erwartet einen aspirationalen, design-orientierten Ton.</internal>
    <productName>CedarWood Schreibtisch 180 cm</productName>
    <keyFeatures>Massives Zedernholz, elektrisch höhenverstellbar 68-118 cm, integriertes Kabelmanagement, Anti-Kollisions-Sensor, 10 Jahre Garantie</keyFeatures>
    <targetAudience>Design-bewusste Home-Office-Einrichter</targetAudience>
    <pricePoint>premium</pricePoint>
    <wordLimit>100-140 words</wordLimit>
  </product>

</products>
