[PROJECT]
    ENCODING=windows-1252
    TARGET_DIR = .\run
    Version = 3.0
    Project.xpj
    // RUNENV.FILE = .env
    AUX.FILE = readme.md
    
[project.xpj]
    sql-generator-agent-registered.exe
    sql-generator-agent-retry.exe
    support-triage-agent.exe
    ticket-router.exe
    retrieve-invoice-details.exe
    complaint-handler.exe
    product-desc-agent.exe
    calculator-tool.exe
    northwind-analyst.exe

[sql-generator-agent-registered.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           = 
    RC_COMPILE           = arc
    RC_FLAGS             = 
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    TARGET_DIR           = .\.
    DEPENDS_ON           = $(ASSETS_PATH)\agentic-ai-core
    DEPENDS_ON           = $(ASSETS_PATH)\http-streams
    DEPENDS_ON           = $(ASSETS_PATH)\libcurl-wrapper
// $START-AUTODEPEND
    sql-generator-agent-common.obj
    sql-generator-agent-registered.obj
    sql-generator-main.obj
// $STOP-AUTODEPEND
    sql-generator-agent-common.prg
    sql-generator-agent-registered.prg
    sql-generator-main.prg

